public class PrimeNumber{
    public static boolean isPrime(int num){
        
        if(num<=1){
            System.out.println("not prime");
            return false;
        }
        for(int i=2; i<=(float)Math.sqrt(num); i++){ 
            if(num%i==0){
                System.out.println("not prime");
                return false;
            }
        } 
        System.out.println("Prime");
        return true;
    }
}
